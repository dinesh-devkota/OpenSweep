<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for OpenSweep.
     Paste this into SignPath: Project "OpenSweep" > Artifact configurations > default.
     The GitHub workflow uploads dist/OpenSweep.exe as a ZIP artifact and passes the version parameter. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OpenSweep.exe" product-name="OpenSweep" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
