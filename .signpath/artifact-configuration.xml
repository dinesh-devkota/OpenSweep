<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for OpenSweep.
     Paste this into SignPath: Project "OpenSweep" > Artifact configurations > default.
     The GitHub workflow submits two signing requests, each a ZIP with one exe:
     first OpenSweep.exe, then OpenSweep-Setup.exe (which packages the signed OpenSweep.exe). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set>
      <include path="OpenSweep.exe" min-matches="0" max-matches="1" product-name="OpenSweep" product-version="${version}" />
      <include path="OpenSweep-Setup.exe" min-matches="0" max-matches="1" product-name="OpenSweep" product-version="${version}" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
