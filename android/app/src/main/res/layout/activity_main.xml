<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <!-- The adaptive icon has an explicit size independent of the text. -->
    <LinearLayout tools:ignore="UseCompoundDrawables" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:paddingHorizontal="20dp" android:gravity="center_vertical">
        <ImageView android:layout_width="38dp" android:layout_height="38dp"
            android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="@string/app_name" android:textSize="21sp"
            android:textColor="@color/ink" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <!-- The adaptive icon has an explicit size independent of the text. -->
    <LinearLayout tools:ignore="UseCompoundDrawables" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="12dp" android:paddingVertical="4dp">
        <Button android:id="@+id/tab_storage" style="@style/TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/storage" />
        <Button android:id="@+id/tab_apps" style="@style/TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/apps" />
        <Button android:id="@+id/tab_device" style="@style/TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/device" />
    </LinearLayout>
</LinearLayout>
