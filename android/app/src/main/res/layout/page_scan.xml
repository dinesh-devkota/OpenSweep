<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ListView android:id="@+id/files" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:clipToPadding="false" android:paddingBottom="12dp" />
    <TextView android:id="@+id/selected_size" style="@style/BodyText" android:gravity="center" />
    <Button android:id="@+id/primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:layout_marginHorizontal="16dp" android:layout_marginVertical="8dp"
        android:text="@string/scan_again" android:textSize="16sp" android:textAllCaps="false"
        android:textColor="@color/action_ink" android:backgroundTint="@color/action_fill" />
</LinearLayout>
