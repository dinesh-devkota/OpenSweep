<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp"
    android:orientation="vertical" android:paddingHorizontal="16dp">
    <TextView android:id="@+id/group_title" style="@style/BodyText" android:layout_marginTop="14dp"
        android:padding="8dp" android:textStyle="bold" android:textColor="@color/accent"
        android:background="@drawable/folder_panel" android:visibility="gone" />
    <CheckBox android:id="@+id/file_check" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="60dp" android:paddingVertical="8dp"
        android:paddingStart="12dp" android:paddingEnd="0dp" android:gravity="center_vertical"
        android:textDirection="firstStrong" android:textColor="@color/ink" android:textSize="16sp" />
    <Button android:id="@+id/keep_copy" style="@style/TextButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/keep_this_copy" android:visibility="gone" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
</LinearLayout>
