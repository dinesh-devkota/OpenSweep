<UserControl x:Class="OpenSweep.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <Grid MinHeight="670" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Maintenance history" Style="{StaticResource H1}"/>
                <TextBlock Text="Saved locally on this PC. Keeps up to 200 recent operations within 32 MB. Review results and available recovery options." Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                <Border x:Name="HistoryWarning" Style="{StaticResource WarnBanner}" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="Some history could not be saved or read during this session. Maintenance continued, but this list may be incomplete. Check the application log for details." TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Search maintenance history" ToolTip="Search operation names, results, and item details" Margin="0,0,10,0"/>
                <ComboBox x:Name="OutcomeBox" Grid.Column="1" Width="145" SelectionChanged="Outcome_Changed" AutomationProperties.Name="Filter by outcome" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="Refresh_Click" Margin="0"/>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <DataGrid x:Name="RecordsGrid" BorderThickness="0" SelectionMode="Single" SelectionChanged="Record_Changed" AutomationProperties.Name="Maintenance operations">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding StartedText}" SortMemberPath="StartedUtc" Width="140"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="*"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="150"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="No maintenance history yet." Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40,20,0" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <TextBlock x:Name="CountText" Grid.Row="3" Style="{StaticResource Sub}" FontSize="12" Margin="0,9,0,14"/>
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Select an operation" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="DetailSummary" Style="{StaticResource Sub}" Margin="0,7,0,0"/>
                        <TextBlock x:Name="DetailTotals" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <DataGrid x:Name="ItemsGrid" SelectionMode="Single" SelectionChanged="Item_Changed" Height="155" AutomationProperties.Name="Operation item results">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="1.3*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="ItemDetail" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                        <Button x:Name="RecoveryButton" Content="Recovery options" Click="Recovery_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="5" Margin="0,14,0,0">
                <TextBlock Text="File sizes are logical totals, not measured free-space gains. Moving files to the Recycle Bin does not free disk space. Permanent cleanup has no Undo." Style="{StaticResource Sub}" FontSize="12"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Export shown history…" Click="Export_Click"/>
                    <TextBlock Text="Exports can include file paths and backup locations." Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
