<UserControl x:Class="OpenSweep.Pages.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Registry"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,14"
                       Text="Finds leftovers from removed programs: shared DLLs, app paths, uninstall and startup entries, fonts and help files that point to files that no longer exist. Every affected key is backed up to a .reg file before it is changed."/>
            <Border x:Name="AdminNote" Style="{StaticResource InfoBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Info}"
                           Text="Running without administrator rights: machine-wide issues (HKLM) are listed but can only be fixed after “Restart as administrator”."/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" FontSize="18" Text="Not scanned yet"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Click Scan for Issues to check the registry."/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="CurrentText" Style="{StaticResource Sub}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <DataGrid x:Name="IssuesGrid" MouseDoubleClick="OpenKey_Click">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="2*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="Registry key" Binding="{Binding Location}" Width="3*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="FixButton" DockPanel.Dock="Right" Style="{StaticResource BigButton}" Content="Fix selected…" Click="Fix_Click" Margin="0"/>
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan for Issues" Padding="22,11" FontSize="15" Click="Scan_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="20,11" FontSize="15" Click="Cancel_Click"
                    Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Select all" Click="All_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Select none" Click="None_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Open in Regedit" Click="OpenKey_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Restore a backup…" Click="Restore_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>
    </Grid>
</UserControl>
