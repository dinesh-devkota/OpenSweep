<UserControl x:Class="OpenSweep.Pages.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Registry"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,20"
                       Text="Advanced review of possible leftover entries. These findings do not measure PC performance. Every affected registry key is backed up before changes."/>
            <Border x:Name="AdminNote" Style="{StaticResource InfoBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Info}"
                           Text="Running without administrator rights: machine-wide issues (HKLM) are listed but can only be fixed after “Restart as administrator”."/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" Text="Not scanned yet"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Click Scan for Issues to check the registry."/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="CurrentText" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid ClipToBounds="True">
                <DataGrid x:Name="IssuesGrid" MouseDoubleClick="OpenKey_Click" MinColumnWidth="80">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox AutomationProperties.Name="{Binding Problem}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="2*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="Registry key" Binding="{Binding Location}" Width="3*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,44,20,16" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=IssuesGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Registry results" Style="{StaticResource H2}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Any entries found during a scan will appear here for you to review." Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource LinkButton}" Content="Select all" Click="All_Click" Margin="0,0,16,6"/>
                    <Button Style="{StaticResource LinkButton}" Content="Select none" Click="None_Click" Margin="0,0,16,6"/>
                    <Button Style="{StaticResource LinkButton}" Content="Open in Regedit" Click="OpenKey_Click" Margin="0,0,16,6"/>
                    <Button Style="{StaticResource LinkButton}" Content="Restore a backup…" Click="Restore_Click" Margin="0,0,0,6"/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="ScanButton" Content="Scan for Issues" Padding="22,10" Click="Scan_Click" Margin="0,0,10,0"/>
                    <Button x:Name="FixButton" Style="{StaticResource BigButton}" Content="Fix selected…" Click="Fix_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
