<UserControl x:Class="OpenSweep.Pages.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.25*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource H1}" Text="Restore"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="Take a safety snapshot before big changes, roll Windows back with System Restore, or put back registry entries that OpenSweep removed."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="System Restore points" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource LinkButton}" Content="Open System Restore…" Click="OpenRestore_Click" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButton}" Content="System Protection settings…" Click="Protection_Click"
                                VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border x:Name="AdminNote" DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Restart as administrator" Click="Elevate_Click"
                                VerticalAlignment="Center"/>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Windows only lets administrators list and create restore points."/>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="CreateButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Create restore point"
                            Click="Create_Click" Margin="0"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,0,8,0" MaxLength="200" VerticalContentAlignment="Center"
                             ToolTip="Description of the new restore point"/>
                </DockPanel>
                <ProgressBar x:Name="CreateProgress" DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,10" Visibility="Collapsed"/>
                <TextBlock x:Name="PointsText" DockPanel.Dock="Bottom" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                <DataGrid x:Name="PointsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g}" SortMemberPath="Created" Width="150"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                        <DataGridTextColumn Header="No." Binding="{Binding Sequence}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Registry backups" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackupsText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Restore selected backup…" Click="RestoreBackup_Click"/>
                    <Button Content="View" Click="ViewBackup_Click"/>
                    <Button Content="Open backup folder" Click="OpenBackups_Click"/>
                </StackPanel>
                <DataGrid x:Name="BackupsGrid" SelectionMode="Single" MouseDoubleClick="ViewBackup_Click">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g}" SortMemberPath="Created" Width="150"/>
                        <DataGridTextColumn Header="Backup file" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
