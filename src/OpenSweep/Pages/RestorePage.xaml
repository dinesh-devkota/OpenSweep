<UserControl x:Class="OpenSweep.Pages.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource H1}" Text="System restore"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                           Text="Create a restore point before making changes, or return to a previous Windows or registry state."/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" FontSize="19" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows restore points" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="A recovery checkpoint for your system." Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="AdminNote" Style="{StaticResource InfoBanner}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="Administrator access is required to list and create restore points."/>
                            <Button Style="{StaticResource LinkButton}" Content="Restart as administrator" Click="Elevate_Click"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Restore point description" FontWeight="Normal" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DescriptionBox" Margin="0,0,12,0" MaxLength="200" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Restore point description" ToolTip="Description of the new restore point"/>
                        <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Create restore point"
                                Click="Create_Click" Margin="0"/>
                    </Grid>
                    <ProgressBar x:Name="CreateProgress" IsIndeterminate="True" Margin="0,0,0,16" Visibility="Collapsed"/>
                    <DataGrid x:Name="PointsGrid" Height="200" AutomationProperties.Name="Windows restore points">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g}" SortMemberPath="Created" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
                            <DataGridTextColumn Header="No." Binding="{Binding Sequence}" Width="56"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PointsText" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                        <WrapPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Open System Restore…" Click="OpenRestore_Click" Margin="0,0,20,4"/>
                            <Button Style="{StaticResource LinkButton}" Content="System Protection settings…" Click="Protection_Click" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="19" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Registry backups" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="BackupsText" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="BackupsGrid" Height="200" SelectionMode="Single" MouseDoubleClick="ViewBackup_Click"
                              AutomationProperties.Name="Registry backups">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g}" SortMemberPath="Created" Width="150"/>
                            <DataGridTextColumn Header="Backup file" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Restore selected backup…" Click="RestoreBackup_Click" Margin="0,0,10,8"/>
                        <Button Content="View" Click="ViewBackup_Click" Margin="0,0,10,8"/>
                        <Button Content="Open backup folder" Click="OpenBackups_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
