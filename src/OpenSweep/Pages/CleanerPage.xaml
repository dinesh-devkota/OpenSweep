<UserControl x:Class="OpenSweep.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Custom clean"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,20"
                       Text="Choose what to clean and preview the space you can reclaim. Run Cleaner permanently deletes the selected junk."/>
            <Border x:Name="AdminNote" Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warn}"
                           Text="Greyed-out system items need administrator rights. Use “Restart as administrator” at the top to include them."/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="16,18,10,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Text="What to clean" Margin="4,0,0,16"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Select all" Click="All_Click"/>
                        <Button Style="{StaticResource LinkButton}" Content="Select none" Click="None_Click" Margin="10,0,0,0"/>
                        <Button Style="{StaticResource LinkButton}" Content="Defaults" Click="Defaults_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,6,0">
                        <ItemsControl x:Name="GroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,20">
                                        <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding AllChecked, Mode=TwoWay}" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" FontSize="14"
                                                           Foreground="{DynamicResource AccentDark}" Margin="2,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Normal" TextWrapping="Wrap"/>
                                            </Grid>
                                        </CheckBox>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanRun}"
                                                              ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" Margin="0,5">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock x:Name="SummaryTitle" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" Text="Ready to analyze"/>
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Sub}" Margin="0,4,0,0"
                                   Text="Analyze your selection to review files and reclaimable space."/>
                        <ProgressBar x:Name="Progress" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="CurrentText" Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="12.5"/>
                    </StackPanel>
                    <Grid ClipToBounds="True">
                    <DataGrid x:Name="ResultsGrid" MinColumnWidth="70">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Binding="{Binding Group}" Width="150"/>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="90"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,44,20,16" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ResultsGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xEA99;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Analysis results" Style="{StaticResource H2}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Your analysis results will appear here. Nothing is removed during analysis." Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <CheckBox x:Name="OldTempBox" VerticalAlignment="Center" Click="OldTemp_Click" Margin="0,0,0,12">
                    <TextBlock Text="Only delete temporary files older than 24 hours" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="AnalyzeButton" Content="Analyze" Padding="24,10" Click="Analyze_Click" Margin="0,0,10,0"/>
                    <Button x:Name="RunButton" Style="{StaticResource BigButton}" Content="Run Cleaner" Click="Run_Click" Margin="0"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
