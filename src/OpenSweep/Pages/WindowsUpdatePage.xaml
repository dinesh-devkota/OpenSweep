<UserControl x:Class="OpenSweep.Pages.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Windows Update"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,20"
                       Text="Review security fixes, system updates and drivers, then install the ones you choose. Optional updates stay unselected by default."/>
            <Border x:Name="RebootBanner" Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart now…" Click="Restart_Click" Margin="12,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Warn}"
                               Text="A restart is required to finish installing updates."/>
                </DockPanel>
            </Border>
            <Border x:Name="AdminNote" Style="{StaticResource InfoBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Info}"
                           Text="You can check for updates now. Installing them needs administrator rights – use “Restart as administrator” at the top."/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" Text="Not checked yet"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Click Check for Updates. Searching can take a few minutes."/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Grid ClipToBounds="True">
                <DataGrid x:Name="UpdatesGrid" MinColumnWidth="80">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Update" Width="3*" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="KB" Binding="{Binding Kb}" Width="90"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.4*"/>
                    </DataGrid.Columns>
                </DataGrid>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,44,20,16" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=UpdatesGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Available updates" Style="{StaticResource H2}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Available updates will appear here after checking. You choose what gets installed." Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource LinkButton}" Content="Select all" Click="All_Click" Margin="0,0,16,4"/>
                    <Button Style="{StaticResource LinkButton}" Content="Select none" Click="None_Click" Margin="0,0,16,4"/>
                    <Button Style="{StaticResource LinkButton}" Content="Windows Update settings" Click="Settings_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <CheckBox x:Name="OnlineBox" Margin="0,0,0,14" Click="Online_Click"
                          ToolTip="Search Microsoft's servers directly instead of a company WSUS server. Your organisation may prefer that you leave this off.">
                    <TextBlock Text="Search Microsoft directly (bypass a company update server)" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="CheckButton" Content="Check for Updates" Padding="22,10" Click="Check_Click" Margin="0,0,10,0"/>
                    <Button x:Name="InstallButton" Style="{StaticResource BigButton}" Content="Install selected" Click="Install_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
