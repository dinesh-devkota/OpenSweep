<UserControl x:Class="OpenSweep.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource H1}" Text="Settings"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Preferences are saved automatically. Use Apply to update a cleaning schedule."/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0">
                            <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" FontSize="19" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Appearance" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Choose light, dark, or follow Windows." Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="{StaticResource SurfaceRadius}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="App theme" FontWeight="Normal"/>
                                <TextBlock Style="{StaticResource Sub}" Text="System follows your Windows appearance." Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="190" VerticalAlignment="Center"
                                      SelectionChanged="Theme_Changed" AutomationProperties.Name="App theme">
                                <ComboBoxItem Tag="System" Content="System default"/>
                                <ComboBoxItem Tag="Light" Content="Light"/>
                                <ComboBoxItem Tag="Dark" Content="Dark"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Cleaning preferences" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Choose how OpenSweep handles files and running apps." Margin="0,6,0,20"/>
                    <CheckBox x:Name="OldTempBox" Click="Setting_Click" AutomationProperties.Name="Keep recent temporary files">
                        <StackPanel>
                            <TextBlock Text="Keep recent temporary files" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Only delete temporary files older than 24 hours, leaving files in active use alone."/>
                        </StackPanel>
                    </CheckBox>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16"/>
                    <CheckBox x:Name="CloseAppsBox" Click="Setting_Click" AutomationProperties.Name="Close apps automatically">
                        <StackPanel>
                            <TextBlock Text="Close apps automatically" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Close running browsers and apps without asking when cleaning needs access. Otherwise, scheduled cleaning skips them."/>
                        </StackPanel>
                    </CheckBox>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20"/>
                    <TextBlock Text="Excluded folders" FontWeight="Normal"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Cleaning and duplicate scans never touch files inside these folders." Margin="0,6,0,12"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                            <Button Content="Add folder…" Click="AddExclusion_Click" Margin="0,0,0,8"/>
                            <Button Content="Remove" Click="RemoveExclusion_Click" Margin="0"/>
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="ExclusionsList" Height="120" SelectionMode="Extended" BorderBrush="{DynamicResource ControlBorder}"
                                     MouseDoubleClick="Exclusion_DoubleClick" ToolTip="Double-click a folder to open it" AutomationProperties.Name="Excluded folders"/>
                            <TextBlock x:Name="ExclusionsEmpty" Style="{StaticResource Sub}" Margin="16,14" IsHitTestVisible="False"
                                       Text="No excluded folders yet."/>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Registry and updates" Style="{StaticResource H2}" Margin="0,0,0,20"/>
                    <CheckBox x:Name="RestorePointBox" Click="Setting_Click" AutomationProperties.Name="Create a restore point before registry fixes">
                        <StackPanel>
                            <TextBlock Text="Create a restore point before registry fixes" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Requires administrator access. A registry backup is always saved before any fix."/>
                        </StackPanel>
                    </CheckBox>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16"/>
                    <CheckBox x:Name="SilentBox" Click="Setting_Click" AutomationProperties.Name="Install app updates silently">
                        <StackPanel>
                            <TextBlock Text="Install app updates silently" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Keep supported update installers in the background."/>
                        </StackPanel>
                    </CheckBox>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16"/>
                    <CheckBox x:Name="UnknownBox" Click="Setting_Click" AutomationProperties.Name="Include apps with unknown versions">
                        <StackPanel>
                            <TextBlock Text="Include apps with unknown versions" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Show available updates even when the installed version cannot be detected."/>
                        </StackPanel>
                    </CheckBox>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16"/>
                    <CheckBox x:Name="OnlineBox" Click="Setting_Click" AutomationProperties.Name="Check Microsoft directly for Windows updates">
                        <StackPanel>
                            <TextBlock Text="Check Microsoft directly for Windows updates" FontWeight="Normal" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Search Microsoft's servers instead of a company update server."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Scheduled cleaning" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,20"
                               Text="Automatically clean the items selected in Custom Clean. Runs quietly through Windows Task Scheduler and saves results to the log."/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Frequency" FontWeight="Normal" Margin="0,0,0,8"/>
                            <ComboBox x:Name="ScheduleBox" Width="210" VerticalContentAlignment="Center" AutomationProperties.Name="Cleaning frequency">
                                <ComboBoxItem Tag="Off" Content="Off"/>
                                <ComboBoxItem Tag="Daily" Content="Every day"/>
                                <ComboBoxItem Tag="Weekly" Content="Every week (Sunday)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Time" FontWeight="Normal" Margin="0,0,0,8"/>
                            <TextBox x:Name="TimeBox" Width="94" MaxLength="5" ToolTip="24-hour time, for example 13:30" AutomationProperties.Name="Cleaning time in 24-hour format"/>
                        </StackPanel>
                        <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Apply" Click="ApplySchedule_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                    </WrapPanel>
                    <TextBlock x:Name="ScheduleStatus" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                               Text="To include tasks that require administrator rights, set the schedule while running OpenSweep as administrator."/>
                    <Border x:Name="ScheduleHint" Style="{StaticResource InfoBanner}" Margin="0,16,0,0">
                        <TextBlock x:Name="ScheduleHintText" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Installation and data" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="InstallStatus" Style="{StaticResource Sub}"/>
                    <TextBlock x:Name="DataText" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                    <CheckBox x:Name="DesktopBox" Content="Add a desktop shortcut" IsChecked="True" Margin="0,18,0,0"/>
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install" Click="Install_Click" Margin="0,0,10,8"/>
                        <Button x:Name="UninstallButton" Content="Uninstall…" Click="Uninstall_Click" Margin="0,0,10,8"/>
                        <Button Content="Open data folder" Click="DataFolder_Click" Margin="0,0,10,8"/>
                        <Button Content="Open log folder" Click="LogFolder_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="About OpenSweep" Margin="0,0,0,10"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Sub}" Text="A free, open-source PC cleaner and updater. Made available under the MIT License."/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                               Text="An independent project, not affiliated with CCleaner, Piriform or Gen Digital."/>
                    <TextBlock x:Name="SystemText" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="View license" Click="License_Click" Margin="0,0,10,8"/>
                        <Button Content="Website" Click="Website_Click" Margin="0,0,10,8"/>
                        <Button Click="Donate_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                                ToolTip="OpenSweep is free. If it helps you, a small donation keeps it going.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource AccentForeground}"/>
                                <TextBlock Text="Donate" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
