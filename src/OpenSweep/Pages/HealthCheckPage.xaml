<UserControl x:Class="OpenSweep.Pages.HealthCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource H1}" Text="Health Check"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                           Text="One scan for the things that slow a PC down or leave it out of date."/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <Border x:Name="StateBadge" DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top">
                        <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" FontSize="28" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
                        <Button x:Name="FixButton" Style="{StaticResource PrimaryButton}" Content="Fix all" Click="FixAll_Click" IsEnabled="False"/>
                        <Button x:Name="ScanButton" Style="{StaticResource BigButton}" Content="Scan PC" Click="Scan_Click" Margin="0"/>
                    </StackPanel>
                    <StackPanel Margin="16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="ScanProgress" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="CurrentText" Style="{StaticResource Sub}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl x:Name="CardsList" Margin="0,12,-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-4,10,0,0"
                                        Content="{Binding LinkText}" Tag="{Binding Page}" Click="CardLink_Click"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding SoftBrush}">
                                            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Text="{Binding Glyph}"
                                                       Foreground="{Binding Brush}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Title}"/>
                                    </StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,12,0,2" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Value}" Foreground="{Binding Brush}"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Detail}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
