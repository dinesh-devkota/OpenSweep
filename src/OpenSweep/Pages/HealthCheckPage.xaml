<UserControl x:Class="OpenSweep.Pages.HealthCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,28">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource H1}" Text="Health overview"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                           Text="Review cleaning, updates, startup apps, and disk space."/>
            </StackPanel>

            <Border Background="{DynamicResource HeroBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StateBadge" Width="48" Height="48" CornerRadius="{StaticResource SurfaceRadius}" Margin="0,0,20,0" VerticalAlignment="Top">
                            <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Health check" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource HeroSub}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="StateTitle" FontFamily="{StaticResource HeadingFont}" FontSize="26" FontWeight="Normal" Foreground="{DynamicResource HeroText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StateText" Foreground="{DynamicResource HeroSub}" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <ProgressBar x:Name="ScanProgress" Margin="0,20,0,0" Maximum="100" Visibility="Collapsed"/>
                        <TextBlock x:Name="CurrentText" Foreground="{DynamicResource HeroSub}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,18,0,0">
                        <Button x:Name="ScanButton" AutomationProperties.Name="Scan PC" FocusVisualStyle="{StaticResource OnDarkFocus}" Style="{StaticResource BigButton}" Click="Scan_Click" Margin="0,0,10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,9,0"/>
                                <TextBlock Text="Scan PC"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FixButton" FocusVisualStyle="{StaticResource OnDarkFocus}" Content="Fix all" Click="FixAll_Click" IsEnabled="False" Margin="0,0,10,4"
                                Background="{DynamicResource HeroBadge}" BorderBrush="{DynamicResource HeroBadge}" Foreground="{DynamicResource HeroText}" Padding="20,11"/>
                        <Button x:Name="CancelButton" FocusVisualStyle="{StaticResource OnDarkFocus}" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,0,4"
                                Background="{DynamicResource HeroBadge}" BorderBrush="{DynamicResource HeroBadge}" Foreground="{DynamicResource HeroText}" Padding="20,11"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <DockPanel Margin="0,28,0,16">
                <TextBlock Style="{StaticResource H2}" Text="Checks" FontSize="18"/>
            </DockPanel>
            <ItemsControl x:Name="CardsList" Margin="0,0,-14,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="32" Height="32" CornerRadius="{StaticResource SurfaceRadius}" Background="{Binding SoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center" Text="{Binding Glyph}"
                                               Foreground="{Binding Brush}"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource TextSub}" FontSize="12" FontWeight="Normal" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Normal" Margin="0,8,0,7" TextWrapping="Wrap"
                                           Text="{Binding Value}" Foreground="{Binding Brush}"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Sub}" FontSize="12" LineHeight="18" Text="{Binding Detail}" MinHeight="38"/>
                                <Button Grid.Row="4" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-4,16,0,0"
                                        Tag="{Binding Page}" Click="CardLink_Click" Padding="4,5" FontSize="12">
                                    <TextBlock Text="{Binding LinkText}" TextWrapping="Wrap"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="0,12,0,0" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentDark}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="Scan first, then review the results before making changes."
                               Style="{StaticResource Sub}" FontSize="12"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
