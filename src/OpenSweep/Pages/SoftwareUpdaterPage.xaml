<UserControl x:Class="OpenSweep.Pages.SoftwareUpdaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Software updater"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,20"
                       Text="Keep your apps current with Windows Package Manager. Updates come from each publisher's official source and are verified by winget."/>
            <Border x:Name="RestartBanner" Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart options…" Click="RestartSettings_Click" Margin="12,0,0,0"/>
                    <TextBlock Style="{StaticResource Sub}" Foreground="{DynamicResource Warn}" VerticalAlignment="Center"
                               Text="An installer reported that a restart is required. Restart before retrying affected apps."/>
                </DockPanel>
            </Border>
            <Border x:Name="WingetMissing" Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get App Installer" Click="GetWinget_Click" Margin="12,0,0,0"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Warn}"
                               Text="Windows Package Manager (winget) was not found. Install “App Installer” from the Microsoft Store, then come back here."/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" Text="Not checked yet"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Click Check for Updates."/>
                    <ProgressBar x:Name="Progress" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
                <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Installation details" Margin="0,16,0,0">
                    <TextBox x:Name="LogBox" Height="110" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Cascadia Code, Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"/>
                </Expander>
                <Grid ClipToBounds="True">
                <DataGrid x:Name="AppsGrid" MinColumnWidth="80">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Installed" Binding="{Binding Version}" Width="*"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                        <DataGridTextColumn Header="Phase" Binding="{Binding PhaseText}" Width="125"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.6*"/>
                    </DataGrid.Columns>
                </DataGrid>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,44,20,16" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=AppsGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Available app updates" Style="{StaticResource H2}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Available updates will appear here. Choose which apps to update after checking." Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource LinkButton}" Content="Select all" Click="All_Click" Margin="0,0,16,4"/>
                    <Button Style="{StaticResource LinkButton}" Content="Select none" Click="None_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox x:Name="SilentBox" Content="Install silently" Click="Options_Click" Margin="0,0,20,6"
                              ToolTip="Ask installers to run without showing their own windows."/>
                    <CheckBox x:Name="UnknownBox" Content="Include apps with unknown versions" Click="Options_Click" Margin="0,0,0,6"
                              ToolTip="Also list programs whose installed version winget can't detect. Click Check for Updates again after changing this."/>
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="CheckButton" Content="Check for Updates" Padding="22,10" Click="Check_Click" Margin="0,0,10,0"/>
                    <Button x:Name="RetryButton" Content="Retry failed" Click="Retry_Click" IsEnabled="False" Margin="0,0,10,0"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource BigButton}" Content="Update selected" Click="Update_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
