<UserControl x:Class="OpenSweep.Pages.UninstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource H1}" Text="Installed apps"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                       Text="Make room for what matters. Uninstall opens the app’s own uninstaller; Remove entry is only for apps that are already gone."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}" Margin="12,0,0,0"/>
            <Grid MaxWidth="380" HorizontalAlignment="Stretch">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="38,10,12,10" ToolTip="Search installed apps by name or publisher"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="14,0,0,0" Foreground="{DynamicResource TextMuted}"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Search apps or publishers" Margin="40,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSub}" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ProgramsGrid" BorderThickness="0" SelectionMode="Single" MouseDoubleClick="Uninstall_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.2*"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.3*"/>
                    <DataGridTextColumn Header="Installed on" Binding="{Binding InstalledText}" SortMemberPath="InstalledOn" Width="100"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="85"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/>
                    <DataGridTextColumn Header="For" Binding="{Binding Scope}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Windows apps settings" Click="Settings_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Uninstall…" Click="Uninstall_Click" Margin="0,0,8,6"/>
                <Button Content="Open install folder" Click="OpenFolder_Click" Margin="0,0,8,6"/>
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,6"/>
                <Button Content="Remove entry…" Click="RemoveEntry_Click" Margin="0,0,0,6" Foreground="{DynamicResource Danger}"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
