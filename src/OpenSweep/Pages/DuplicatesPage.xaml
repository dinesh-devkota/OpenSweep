<UserControl x:Class="OpenSweep.Pages.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource H1}" Text="Duplicate Finder"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="Find identical copies of files (same size and same content). Windows and program folders are skipped, and one copy in every group is always kept."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,24,0">
                    <TextBlock DockPanel.Dock="Top" Text="Search in" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="Add folder…" Click="AddFolder_Click" Margin="0,0,0,6"/>
                        <Button Content="Remove" Click="RemoveFolder_Click" Margin="0"/>
                    </StackPanel>
                    <ListBox x:Name="FolderList" Height="74" BorderBrush="{DynamicResource Line}"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Width="310">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Ignore files smaller than" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MinSizeBox" SelectedIndex="2" Padding="8,5">
                            <ComboBoxItem Content="(include all files)" Tag="1"/>
                            <ComboBoxItem Content="100 KB" Tag="102400"/>
                            <ComboBoxItem Content="1 MB" Tag="1048576"/>
                            <ComboBoxItem Content="10 MB" Tag="10485760"/>
                            <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        </ComboBox>
                    </DockPanel>
                    <CheckBox x:Name="SkipHiddenBox" Content="Skip hidden and system files" IsChecked="True" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
                        <Button x:Name="SearchButton" Style="{StaticResource PrimaryButton}" Content="Search" Click="Search_Click" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis"
                           Text="Choose where to look and click Search."/>
                <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ResultsGrid" BorderThickness="0" CanUserSortColumns="False" MouseDoubleClick="Show_Click"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentDark}" Margin="10,12,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Click="FileCheck_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Remove this copy"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="1.3*"/>
                        <DataGridTemplateColumn Header="Folder" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSub}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Delete selected…" Click="Delete_Click"
                    Padding="22,11" FontSize="15" Margin="0"/>
            <Button DockPanel.Dock="Right" Content="Open containing folder" Click="Show_Click" Padding="22,11" FontSize="15" Margin="0,0,10,0"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Select all but newest" Click="KeepNewest_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Select all but oldest" Click="KeepOldest_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Clear selection" Click="Clear_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="SelectedText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}" Margin="18,0,0,0"/>
        </DockPanel>
    </Grid>
</UserControl>
