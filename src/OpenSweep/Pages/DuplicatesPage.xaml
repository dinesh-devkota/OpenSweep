<UserControl x:Class="OpenSweep.Pages.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
    <Grid MinHeight="620" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource H1}" Text="Duplicate finder"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                       Text="Find files with identical content and reclaim the extra space. One copy is always kept; Windows and program folders are skipped."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18,16">
            <StackPanel>
                <TextBlock Text="Search locations" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                        <Button Content="Add folder…" Click="AddFolder_Click" Margin="0,0,0,6"/>
                        <Button Content="Remove" Click="RemoveFolder_Click" Margin="0"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="FolderList" Height="80" BorderBrush="{DynamicResource Line}"/>
                        <TextBlock Text="Add the folders you want to compare" Margin="14,12" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Sub}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=FolderList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="Min. size" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSub}"/>
                        <ComboBox x:Name="MinSizeBox" SelectedIndex="2" Width="130">
                            <ComboBoxItem Content="All files" Tag="1"/>
                            <ComboBoxItem Content="100 KB" Tag="102400"/>
                            <ComboBoxItem Content="1 MB" Tag="1048576"/>
                            <ComboBoxItem Content="10 MB" Tag="10485760"/>
                            <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="SkipHiddenBox" Content="Skip hidden / system files" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,8"/>
                    <Button x:Name="SearchButton" Style="{StaticResource PrimaryButton}" Content="Find duplicates" Click="Search_Click" Margin="0,0,8,8"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis"
                           Text="Choose your folders, then find duplicates to review them here."/>
                <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ResultsGrid" BorderThickness="0" CanUserSortColumns="False" MouseDoubleClick="Show_Click"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Normal" Foreground="{DynamicResource AccentDark}" Margin="10,12,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Click="FileCheck_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Remove this copy"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="1.3*"/>
                        <DataGridTemplateColumn Header="Folder" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSub}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel Margin="0,0,0,10">
                <Button Style="{StaticResource LinkButton}" Content="Keep newest" ToolTip="Select every copy except the newest in each group" Click="KeepNewest_Click" Margin="0,0,16,4"/>
                <Button Style="{StaticResource LinkButton}" Content="Keep oldest" ToolTip="Select every copy except the oldest in each group" Click="KeepOldest_Click" Margin="0,0,16,4"/>
                <Button Style="{StaticResource LinkButton}" Content="Clear selection" Click="Clear_Click" Margin="0,0,16,4"/>
                <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
            </WrapPanel>
            <WrapPanel>
                <Button Style="{StaticResource DangerButton}" Content="Delete selected…" Click="Delete_Click" Margin="0,0,8,6"/>
                <Button Content="Open containing folder" Click="Show_Click" Margin="0,0,0,6"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
