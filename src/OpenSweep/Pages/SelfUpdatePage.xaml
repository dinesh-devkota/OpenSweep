<UserControl x:Class="OpenSweep.Pages.SelfUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,28">
            <TextBlock Style="{StaticResource H1}" Text="OpenSweep updates"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,24" Text="Check the official GitHub releases, review what changed, and choose when to download an update."/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="StartupCheckBox" Click="StartupCheck_Click" Margin="0,16,0,8">
                        <TextBlock Text="Check for OpenSweep updates when I open the app" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Optional startup checks contact GitHub at most once a day. They notify you about a stable release; nothing is downloaded or installed automatically."/>
                </StackPanel>
            </Border>
            <Border x:Name="TrustBanner" Style="{StaticResource InfoBanner}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TrustTitle" FontWeight="SemiBold" Text="Checking installation trust…"/>
                    <TextBlock x:Name="TrustText" Style="{StaticResource Sub}" Margin="0,6,0,0" Text="Windows must trust both the current app and the downloaded file, with the same signing key."/>
                    <Button Style="{StaticResource LinkButton}" Content="Open official releases" Click="OpenRelease_Click" HorizontalAlignment="Left" Margin="-4,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" Text="Ready to check" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" Margin="0,6,0,16" Text="Only published stable versions newer than your current version can be downloaded here."/>
                    <WrapPanel>
                        <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" Margin="0,0,8,6"/>
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <ProgressBar x:Name="Progress" Margin="0,12,0,0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel x:Name="ReleasePanel" Visibility="Collapsed" Margin="0,20,0,0">
                        <TextBlock x:Name="ReleaseTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ReleaseNotes" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="210"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Margin="0,12,0,14"
                                 AutomationProperties.Name="Release notes"/>
                        <Button Style="{StaticResource LinkButton}" Content="Read this release on GitHub" Click="OpenRelease_Click" HorizontalAlignment="Left" Margin="-4,0,0,14"/>
                        <TextBlock Style="{StaticResource Sub}" Text="Download format" Margin="0,0,0,6"/>
                        <ComboBox x:Name="AssetSelector" DisplayMemberPath="DisplayName" SelectionChanged="Asset_Changed"
                                  HorizontalAlignment="Left" MinWidth="220" MaxWidth="380" AutomationProperties.Name="Download format"/>
                        <TextBlock x:Name="AssetNote" Style="{StaticResource Sub}" FontSize="12" Margin="0,8,0,14"/>
                        <WrapPanel>
                            <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="Download and verify" Click="Download_Click" IsEnabled="False" Margin="0,0,8,6"/>
                            <Button x:Name="LaunchButton" Content="Launch installer…" Click="Launch_Click" Visibility="Collapsed" Margin="0,0,8,6"/>
                            <Button x:Name="FolderButton" Content="Show verified portable file" Click="Folder_Click" Visibility="Collapsed" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
