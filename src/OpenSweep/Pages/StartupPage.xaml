<UserControl x:Class="OpenSweep.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource H1}" Text="Startup"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="Programs that start automatically when you sign in. Disabling one keeps it installed but stops it from slowing down startup – it uses the same switch as Task Manager's Startup tab, so you can turn it back on at any time."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="EntriesGrid" BorderThickness="0" MouseDoubleClick="OpenLocation_Click">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="50" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" HorizontalAlignment="Center"
                                          ToolTip="Start this program when you sign in"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="1.4*"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="80"/>
                    <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="*"/>
                    <DataGridTemplateColumn Header="Command" Width="2*" SortMemberPath="Command">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSub}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Enable" Click="Enable_Click" Margin="0"/>
            <Button DockPanel.Dock="Right" Content="Disable" Click="Disable_Click"/>
            <Button DockPanel.Dock="Right" Content="Delete…" Click="Delete_Click"/>
            <Button DockPanel.Dock="Right" Content="Open file location" Click="OpenLocation_Click"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextSub}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Windows startup settings" Click="Settings_Click"
                    VerticalAlignment="Center" Margin="14,0,0,0"/>
        </DockPanel>
    </Grid>
</UserControl>
