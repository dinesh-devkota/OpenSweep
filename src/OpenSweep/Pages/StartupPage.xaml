<UserControl x:Class="OpenSweep.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource H1}" Text="Startup apps"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                       Text="Choose what starts with Windows. Disable an app without uninstalling it, and turn it back on whenever you need it."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="EntriesGrid" BorderThickness="0" MouseDoubleClick="OpenLocation_Click">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="50" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" HorizontalAlignment="Center"
                                          ToolTip="Start this program when you sign in"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="1.4*"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="80"/>
                    <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="*"/>
                    <DataGridTemplateColumn Header="Command" Width="2*" SortMemberPath="Command">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSub}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Windows startup settings" Click="Settings_Click"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Sub}"/>
            </DockPanel>
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Enable selected" Click="Enable_Click" Margin="0,0,8,6"/>
                <Button Content="Disable" Click="Disable_Click" Margin="0,0,8,6"/>
                <Button Content="Open file location" Click="OpenLocation_Click" Margin="0,0,8,6"/>
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,6"/>
                <Button Content="Delete entry…" Click="Delete_Click" Margin="0,0,0,6" Foreground="{DynamicResource Danger}"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
