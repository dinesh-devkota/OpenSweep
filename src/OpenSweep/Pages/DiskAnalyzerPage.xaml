<UserControl x:Class="OpenSweep.Pages.DiskAnalyzerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PercentCell">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSub}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource H1}" Text="Disk Analyzer"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="See what is filling up a drive or folder: the biggest folders, space per file type and the largest files."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Analyze" Click="Analyze_Click" Margin="0"/>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Choose folder…" Click="Browse_Click"/>
                    <ComboBox x:Name="DriveBox" DisplayMemberPath="Label" Margin="0,0,8,0" Padding="8,6" VerticalContentAlignment="Center"/>
                </DockPanel>
                <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource Sub}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                           Text="Pick a drive or folder and click Analyze."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs" IsEnabled="False" Padding="0,8,0,0">
            <TabItem Header="Folders">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="UpButton" DockPanel.Dock="Left" Click="Up_Click" Padding="10,5" ToolTip="Up one level">
                            <TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Open in Explorer" Click="OpenFolder_Click" Margin="8,0,0,0"/>
                        <TextBlock x:Name="PathText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataGrid x:Name="FolderGrid" MouseDoubleClick="Folder_DoubleClick" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14"
                                                       Foreground="{DynamicResource Warn}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
                            <DataGridTemplateColumn Header="Share" Width="1.4*" SortMemberPath="Percent" CellTemplate="{StaticResource PercentCell}"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="File types">
                <DataGrid x:Name="CategoryGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="110"/>
                        <DataGridTemplateColumn Header="Share" Width="1.5*" SortMemberPath="Percent" CellTemplate="{StaticResource PercentCell}"/>
                        <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Files" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Largest files">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open containing folder" Click="ShowFile_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="Move to Recycle Bin…" Click="RecycleFile_Click"/>
                        <TextBlock x:Name="FileStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="FilesGrid" MouseDoubleClick="ShowFile_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=d}" Width="100"/>
                            <DataGridTemplateColumn Header="Folder" Width="2*" SortMemberPath="Folder">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSub}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
