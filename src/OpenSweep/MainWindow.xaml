<Window x:Class="OpenSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SqueakySift" Width="1240" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBg}" Foreground="{DynamicResource TextMain}"
        FontFamily="{StaticResource AppFont}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Icon="Assets/SqueakySift.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource AccentSoft}">
                            <TextBlock Text="&#xEA99;" FontFamily="{StaticResource Icons}" FontSize="18"
                                       Foreground="{DynamicResource AccentDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SqueakySift" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource HeroText}"/>
                            <TextBlock Text="PC maintenance" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource SidebarMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource SidebarHover}" Margin="0,24,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,22">
                    <Border Height="1" Background="{DynamicResource SidebarHover}" Margin="22,0,22,12"/>
                    <RadioButton x:Name="NavOptions" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 CommandParameter="options" Checked="Nav_Checked"/>
                    <TextBlock x:Name="VersionText" Margin="24,16,12,0" FontSize="11" Foreground="{DynamicResource SidebarMuted}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel">
                        <TextBlock Style="{StaticResource SideHeader}" Text="PC care"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE95E;" Content="Health overview" CommandParameter="health" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Windows care" CommandParameter="care" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xEA99;" Content="Custom clean" CommandParameter="cleaner" Checked="Nav_Checked"/>

                        <TextBlock Style="{StaticResource SideHeader}" Text="Updates"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE896;" Content="Software updater" CommandParameter="updater" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE895;" Content="Windows Update" CommandParameter="winupdate" Checked="Nav_Checked"/>

                        <TextBlock Style="{StaticResource SideHeader}" Text="Your tools"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7E8;" Content="Startup apps" CommandParameter="startup" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Uninstaller" CommandParameter="uninstall" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Disk analyzer" CommandParameter="disk" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8C8;" Content="Duplicate finder" CommandParameter="dupes" Checked="Nav_Checked"/>
                        <TextBlock Style="{StaticResource SideHeader}" Text="Advanced"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Registry" CommandParameter="registry" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE777;" Content="System restore" CommandParameter="restore" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="30,17">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border x:Name="AdminBadge" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource ControlRadius}" Padding="12,8" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource AccentDark}"/>
                                <TextBlock Text="Administrator" Margin="7,0,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AccentDark}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ElevateButton" AutomationProperties.Name="Restart as administrator" Click="Elevate_Click" Visibility="Collapsed" Margin="0" Padding="12,8" FontSize="12"
                                ToolTip="Restart as administrator for system-wide cleaning, registry fixes for all users, restore points and Windows Update installs.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextSub}"/>
                                <TextBlock Text="Restart as admin" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="{StaticResource SurfaceRadius}" Background="{DynamicResource SurfaceAlt}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="This PC" Style="{StaticResource Eyebrow}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="SummaryText" Text="Reading system information…" Foreground="{DynamicResource TextSub}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
